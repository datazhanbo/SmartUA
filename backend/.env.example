# Database
DATABASE_URL=sqlite:///./smartua.db

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=SmartUA Platform
DEBUG=true
ENV=development

# Timezone
DEFAULT_TIMEZONE=Asia/Shanghai

# AI / LLM
# LLM_API_KEY=your-anthropic-or-openai-key
# LLM_MODEL=claude-3-5-sonnet-20241022

# ===== Google Ads 连接器（真实渠道；全部留空则自动回退 mock） =====
# 全部填入后 SmartUA 即走真实 Google Ads API；需运行环境能安装 google-ads SDK / grpcio。
# 凭证获取：Google Ads 后台 → API Center 拿 developer_token；
#   Google Cloud OAuth 2.0 拿 client_id/secret，用 refresh-token 流程换 refresh_token；
#   customer_id 为运营客户 ID（纯数字，无连字符），login_customer_id 为 MCC 登录 ID（可选）。
# GOOGLE_DEVELOPER_TOKEN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CUSTOMER_ID=
# GOOGLE_LOGIN_CUSTOMER_ID=

# 默认执行平台：google（真实）/ mock（因果模拟）/ meta / tiktok
# AGENT_DEFAULT_PLATFORM=google
