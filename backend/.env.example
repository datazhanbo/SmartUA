# Database
DATABASE_URL=sqlite:///./smartua.db

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=SmartUA Platform
DEBUG=true
ENV=development

# Timezone
DEFAULT_TIMEZONE=Asia/Shanghai

